# Copy to .env and fill in. docker-compose reads .env automatically.
#   cp .env.example .env
#
# Postgres, MongoDB and Redis all run as containers (see docker-compose.yml) —
# you do NOT need Neon, Atlas, or any external database for `docker compose up`.

# --- Auth -----------------------------------------------------------------
# Any non-empty random string. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=dev-only-change-me

# Resend API key for the magic-link login email. Leave empty to skip emails;
# email login won't work without it, but guest sessions work fine regardless.
RESEND_API=

# --- URLs -------------------------------------------------------------------
# VITE_* vars are compiled into the frontend bundle at BUILD time, so changing
# them requires `docker compose up --build` again. They must be reachable
# from your BROWSER, so keep them as localhost + the published port.
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:8080
VITE_BINANCE_KLINES_API_URL=https://fapi.binance.com/fapi/v1/klines

API_BASE_URL=http://localhost:3001/api/v1
CORS_ORIGIN=http://localhost:5173

# --- Market data --------------------------------------------------------------
BACKPACK_URL=wss://ws.backpack.exchange

# --- Only needed if you want to point at real cloud databases instead of ----
# --- the bundled Postgres/MongoDB containers. If you set these, also edit --
# --- docker-compose.yml to remove the postgres/mongodb services and the   --
# --- hardcoded DATABASE_URL/MONGODB_URL, and set NODE_ENV=production for  --
# --- backend & engine (see README-DOCKER.md). -------------------------------
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/Exness