# Copy to .env and fill in.  docker compose reads .env automatically.
#   cp .env.example .env

# --- Neon Postgres (REQUIRED) -------------------------------------------------
# The app uses @neondatabase/serverless, so this must be a Neon URL:
#   postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
# Get it from the Neon console -> Connection Details.
# Use the DIRECT host (no "-pooler.") -- the migrate step needs a non-pooled
# connection. The pooled host works for the app but not for DDL.
DATABASE_URL=

# --- Auth ---------------------------------------------------------------------
# Any non-empty random string. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# Resend API key for the magic-link login email. Leave empty to skip emails;
# login will not work without it in a real browser flow.
RESEND_API=

# --- URLs ---------------------------------------------------------------------
# These are compiled into the frontend bundle at BUILD time, so changing them
# requires `docker compose up --build` again.
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:8080
API_BASE_URL=http://localhost:3001/api/v1
CORS_ORIGIN=http://localhost:5173

# --- Market data --------------------------------------------------------------
BACKPACK_URL=wss://ws.backpack.exchange
